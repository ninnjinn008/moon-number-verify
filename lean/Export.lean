  (AbsF.conj (AbsF.conj (AbsF.conj (AbsF.d0 (IsD0.conj (IsD0.ball 3 0 (by decide) (IsD0.neg (IsD0.ball 4 3 (by decide) (IsD0.neg (IsD0.mem 4 0))))) (IsD0.ball 2 0 (by decide) (IsD0.neg (IsD0.ball 5 2 (by decide) (IsD0.neg (IsD0.ball 6 5 (by decide) (IsD0.neg (IsD0.mem 6 2))))))))) (AbsF.neg (AbsF.outside 7 (AbsF.d0 (IsD0.neg (IsD0.mem 7 0))) (by intro e x he hx; have k1 : ∀ n, ¬ mem x (e n) := fun n h => hx (trans _ _ (he n) h); have k2 : ∀ n, x ≠ e n := fun n h => hx (h ▸ he n); simp [evalU, upd, k1, k2])))) (AbsF.neg (AbsF.neg (AbsF.ball 8 0 (by decide) (AbsF.outside 9 (AbsF.d0 (IsD0.conj (IsD0.neg (IsD0.conj (IsD0.mem 9 0) (IsD0.neg (IsD0.neg (IsD0.conj (IsD0.neg (IsD0.mem 9 8)) (IsD0.neg (IsD0.eq 9 8))))))) (IsD0.neg (IsD0.conj (IsD0.neg (IsD0.conj (IsD0.neg (IsD0.mem 9 8)) (IsD0.neg (IsD0.eq 9 8)))) (IsD0.neg (IsD0.mem 9 0)))))) (by intro e x he hx; have k1 : ∀ n, ¬ mem x (e n) := fun n h => hx (trans _ _ (he n) h); have k2 : ∀ n, x ≠ e n := fun n h => hx (h ▸ he n); simp [evalU, upd, k1, k2])))))) (AbsF.ball 1 0 (by decide) (AbsF.neg (AbsF.neg (AbsF.conj (AbsF.neg (AbsF.outside 10 (AbsF.d0 (IsD0.neg (IsD0.mem 10 1))) (by intro e x he hx; have k1 : ∀ n, ¬ mem x (e n) := fun n h => hx (trans _ _ (he n) h); have k2 : ∀ n, x ≠ e n := fun n h => hx (h ▸ he n); simp [evalU, upd, k1, k2]))) (AbsF.neg (AbsF.neg (AbsF.ball 11 1 (by decide) (AbsF.outside 12 (AbsF.d0 (IsD0.conj (IsD0.neg (IsD0.conj (IsD0.mem 12 1) (IsD0.neg (IsD0.neg (IsD0.conj (IsD0.neg (IsD0.mem 12 11)) (IsD0.neg (IsD0.eq 12 11))))))) (IsD0.neg (IsD0.conj (IsD0.neg (IsD0.conj (IsD0.neg (IsD0.mem 12 11)) (IsD0.neg (IsD0.eq 12 11)))) (IsD0.neg (IsD0.mem 12 1)))))) (by intro e x he hx; have k1 : ∀ n, ¬ mem x (e n) := fun n h => hx (trans _ _ (he n) h); have k2 : ∀ n, x ≠ e n := fun n h => hx (h ▸ he n); simp [evalU, upd, k1, k2]))))))))))
theorem abs_is_omega {α : Type} (mem : α → α → Prop) (U : α → Prop)
    (trans : ∀ x y, U y → mem x y → U x) (e : Nat → α) (he : ∀ n, U (e n)) :
    evalU mem U f_is_omega e ↔ evalU mem (fun _ => True) f_is_omega e :=
  absoluteF mem U trans (absF_is_omega mem U trans) e he

